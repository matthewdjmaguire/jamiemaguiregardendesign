---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryBlock from '../components/EnquiryBlock.astro';
import { site } from '../data/site';
import { homeHero as hero } from '../data/images';
---

<BaseLayout>
  <PageHero image={hero} size="large" eyebrow="Garden and planting design" title={site.tagline} />

  <section class="section section--sage">
    <div class="container">
      <div class="section-head">
        <p class="lead">
          I design elegant but liveable gardens that work hard throughout the seasons. I create spaces that are both
          beautiful and ecologically friendly, supporting pollinators and wildlife within them.
        </p>
        <p class="lead">
          Prior to retraining at the London College of Garden Design, I spent over 15 years working as a commercial
          property lawyer so I also bring extensive project management experience, clarity of communication and
          professionalism to everything I do.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>How I can help</h2>
      </div>
      <div class="cards">
        {
          site.services.map((s, i) => (
            <article class="card">
              <div class="card__num">{String(i + 1).padStart(2, '0')}</div>
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
              <a href={`/services#${s.id}`}>Learn more</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="btn-row btn-row--center">
        <a class="btn btn--outline btn--large" href="/projects">View recent projects</a>
      </div>
    </div>
  </section>

  <EnquiryBlock />
</BaseLayout>
