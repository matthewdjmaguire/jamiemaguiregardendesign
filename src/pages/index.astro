---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryBlock from '../components/EnquiryBlock.astro';
import { site } from '../data/site';
import { homeHero as hero } from '../data/images';
---

<BaseLayout>
  <PageHero image={hero} size="large" eyebrow={['Garden and planting design', site.area]} title={site.tagline}>
    <p>
      Prior to retraining as a Garden Designer at the London College of Garden Design, I spent over 15 years working
      as a commercial property lawyer so bring extensive project management experience, clarity of communication and
      professionalism to everything I do.
    </p>
  </PageHero>

  <section class="section section--sage">
    <div class="container">
      <div class="section-head">
        <h2>Considered planting, sustainable materials, gardens made to be lived in.</h2>
        <p class="lead">
          I'm a garden designer trained at the London College of Garden Design. I create gardens that feel elegant,
          work hard through the seasons and look after the wildlife around them.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>How I can help</h2>
      </div>
      <div class="cards">
        {
          site.services.map((s, i) => (
            <article class="card">
              <div class="card__num">{String(i + 1).padStart(2, '0')}</div>
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
              <a href={`/services#${s.id}`}>Learn more</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="btn-row btn-row--center">
        <a class="btn btn--outline" href="/projects">View recent projects</a>
      </div>
    </div>
  </section>

  <EnquiryBlock />
</BaseLayout>
