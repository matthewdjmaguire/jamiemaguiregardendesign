---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryBlock from '../components/EnquiryBlock.astro';
import { secondaryHero as aboutImage } from '../data/images';
import LcgdBadge from '../components/LcgdBadge.astro';
---

<BaseLayout title="About" description="About Jamie Maguire: a garden designer trained at the London College of Garden Design, creating thoughtful, elegant and liveable gardens.">
  <PageHero image={aboutImage} eyebrow="About" />

  <section class="section">
    <div class="container split">
      <div>
        <p class="lead">
          After over 15 years working as a commercial property lawyer in London, I retrained as a garden designer
          with the London College of Garden Design, graduating with Merit Commended in 2026. Art and design have
          always been a passion of mine – I studied Design Technology for A Level and History of Art at Edinburgh
          University. My years working as a lawyer taught me excellent project management, communication and problem
          solving skills which I will now bring with me into this new career.
        </p>
      </div>
      <aside class="panel" aria-labelledby="at-a-glance">
        <h2 id="at-a-glance">At a glance</h2>
        <ul>
          <li>Garden Design Diploma 2026 (London College of Garden Design)</li>
          <li>Over 15 years experience as a commercial property lawyer</li>
          <li>Currently studying the RHS Level 2 with Royal Botanic Garden Edinburgh</li>
          <li>Due to start the Planting Design Diploma at London College of Garden Design in January 2027</li>
        </ul>
        <p class="panel__logo"><LcgdBadge /></p>
      </aside>
    </div>
  </section>

  <EnquiryBlock />
</BaseLayout>
