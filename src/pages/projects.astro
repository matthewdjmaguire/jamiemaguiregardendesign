---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProjectLightbox from '../components/ProjectLightbox.astro';
import { getProjects } from '../lib/projects';
import EnquiryBlock from '../components/EnquiryBlock.astro';
import heroImage from '../assets/placeholders/hero.svg';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="A selection of garden design projects by Jamie Maguire.">
  <PageHero image={heroImage} eyebrow="Projects" title="Gardens I have designed" />

  <section class="section">
    <div class="container">
      <p class="lead lead--narrow">Select an image to see it larger.</p>
      <ProjectGrid projects={projects} lightbox />
      <ProjectLightbox projects={projects} />
    </div>
  </section>

  <EnquiryBlock />
</BaseLayout>
