---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  eyebrow?: string;
  title: string;
  size?: 'large' | 'small';
}

const { image, eyebrow, title, size = 'small' } = Astro.props;
---

<section class={`hero hero--${size}`}>
  <div class="hero__media">
    {/* Decorative: the text carries the meaning, so the image has empty alt. */}
    <Image src={image} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <slot />
  </div>
</section>
