---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  eyebrow?: string | string[]; // string[] renders as separate lines (e.g. the Home hero's two-line label)
  title?: string; // omit to drop the big heading; the eyebrow is then promoted to the page's <h1> so every page keeps one
  size?: 'large' | 'small';
}

const { image, eyebrow, title, size = 'small' } = Astro.props;
const eyebrowLines = Array.isArray(eyebrow) ? eyebrow : eyebrow ? [eyebrow] : [];
---

<section class={`hero hero--${size}`}>
  <div class="hero__media">
    {/* Decorative: the text carries the meaning, so the image has empty alt. */}
    <Image src={image} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="hero__inner">
    {
      title ? (
        <>
          {eyebrowLines.length > 0 && (
            <p class="eyebrow">{eyebrowLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
          )}
          <h1>{title}</h1>
        </>
      ) : (
        eyebrowLines.length > 0 && (
          <h1 class="eyebrow">{eyebrowLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
        )
      )
    }
    <slot />
  </div>
</section>
