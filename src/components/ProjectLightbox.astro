---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

{
  projects.map((project) => (
    <dialog class="lightbox" id={`lightbox-${project.id}`} aria-label={`${project.data.title}, ${project.data.location}`}>
      <div class="lightbox__inner">
        <div class="lightbox__stage">
          <button class="lb-btn lb-close" type="button" data-lightbox-close aria-label="Close">&times;</button>
          {project.data.images.length > 1 && (
            <button class="lb-btn lb-prev" type="button" data-lightbox-prev aria-label="Previous image">&#8249;</button>
          )}
          {project.data.images.map((img, i) => (
            <figure data-active={i === 0 ? 'true' : 'false'}>
              {/* Two sizes are enough: the source photos are only ~1400px wide. */}
              <Image src={img.src} alt={img.alt} widths={[1000, 1600]} sizes="100vw" loading="lazy" />
            </figure>
          ))}
          {project.data.images.length > 1 && (
            <button class="lb-btn lb-next" type="button" data-lightbox-next aria-label="Next image">&#8250;</button>
          )}
        </div>
        <div class="lightbox__meta">
          <h2>{project.data.title}</h2>
          <p>{project.data.location} &middot; {project.data.summary}</p>
        </div>
      </div>
    </dialog>
  ))
}

<script>
  // Lightbox behaviour. Uses the native <dialog> so Esc, focus trapping and screen-reader
  // semantics come from the browser. This script only handles opening, closing and paging.
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((tile) => {
    const dialog = document.getElementById(`lightbox-${tile.dataset.lightboxOpen}`) as HTMLDialogElement | null;
    if (!dialog) return;
    const figures = Array.from(dialog.querySelectorAll<HTMLElement>('figure'));
    let index = 0;

    const show = (i: number) => {
      index = (i + figures.length) % figures.length;
      figures.forEach((f, n) => f.setAttribute('data-active', String(n === index)));
    };

    tile.addEventListener('click', () => {
      show(0);
      dialog.showModal();
    });
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));
    // Clicking the dark backdrop (the dialog element itself) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('lightbox__inner')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>
